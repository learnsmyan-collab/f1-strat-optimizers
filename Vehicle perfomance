%==========================================================================
% Project: Longitudinal Vehicle Performance & Aero Sensitivity Engine
% Description: Simulates vehicle acceleration constrained by tire traction
%              and aerodynamic drag, running a Cd sensitivity sweep.
% Author: Smyan Aggarwal
% Date: 2026-07-05
%==========================================================================

clear; clc; close all;

% 1. System Constants & Vehicle Parameters
m = 800;          % Vehicle mass (kg)
g = 9.81;         % Gravity (m/s^2)
mu = 1.6;         % Tire friction coefficient (high-grip compound)
rho = 1.225;      % Air density at sea level (kg/m^3)
A = 1.5;          % Frontal area (m^2)
P_max = 800000;   % Max engine power (W) - ~1070 hp

% 2. Sensitivity Analysis Setup
% Sweep across drag coefficients to see how aero efficiency hits top speed
drag_sweep = 0.6:0.1:1.2; 
final_velocities = zeros(size(drag_sweep));

% 3. Main Simulation Loop
fig1 = figure('Name', 'Performance Sensitivity', 'Position', [100, 100, 700, 400]);
hold on;

for j = 1:length(drag_sweep)
    Cd = drag_sweep(j);
    dt = 0.05;      % Time step for numerical integration (s)
    t = 0:dt:10;    % 10-second simulation window
    v = zeros(size(t));

    for i = 1:length(t)-1
        % aerodynamic drag increases quadratically with speed
        Fd = 0.5 * rho * v(i)^2 * Cd * A;

        % power-limited force at speed (F = P / v), handled carefully near stop
        if v(i) < 1.0
            F_engine = mu * m * g * 0.8; % controlled launch threshold
        else
            F_engine = P_max / v(i);
        end

        % clamp force by absolute tire grip limits (mu * Normal Force)
        F_traction_max = mu * m * g;
        F_engine = min(F_engine, F_traction_max);

        % net force and acceleration (F = ma)
        F_net = F_engine - Fd;
        accel = F_net / m;

        % Euler integration step for velocity
        v(i+1) = v(i) + accel * dt;
    end

    final_velocities(j) = v(end);
    plot(t, v, 'LineWidth', 1.8, 'DisplayName', sprintf('Cd = %.1f', Cd));
end

% Format primary velocity profile plot
xlabel('Time (s)', 'FontSize', 10);
ylabel('Velocity (m/s)', 'FontSize', 10);
title('Vehicle Acceleration Profile Across Aero Configurations', 'FontSize', 11, 'FontWeight', 'bold');
legend('Location', 'southeast', 'FontSize', 8);
grid on;
box on;

% Export graphic asset for portfolio PDF
exportgraphics(fig1, 'vehicle_acceleration.png', 'Resolution', 300);
close(fig1);

% 4. Sensitivity Analysis Plot (Cd vs Final Velocity)
fig2 = figure('Name', 'Drag Sensitivity Result', 'Position', [150, 150, 700, 400]);
plot(drag_sweep, final_velocities, '-o', 'LineWidth', 2, 'MarkerFaceColor', '#0072BD', 'MarkerSize', 6);
xlabel('Drag Coefficient (Cd)', 'FontSize', 10);
ylabel('Final Velocity at 10s (m/s)', 'FontSize', 10);
title('Aerodynamic Efficiency Sensitivity Analysis', 'FontSize', 11, 'FontWeight', 'bold');
grid on;
box on;

% Export secondary sensitivity graphic asset
exportgraphics(fig2, 'aero_sensitivity.png', 'Resolution', 300);
close(fig2);

disp('Simulation complete. Exported high-res assets: "vehicle_acceleration.png" & "aero_sensitivity.png".');
