function F1_Strategy_Sim()
    clc; close all;

    % Inputs
    tyre_age = 18;
    rem_laps = 20;
    sc_status = 'vsc'; % 'none', 'vsc', 'sc'
    base_pit = 22.5;
    base_pace = 90.0;
    wear_rate = 0.08;
    cliff = 0.03;

    % Pit loss adjustment based on track status
    status_lower = lower(sc_status);
    if strcmp(status_lower, 'vsc')
        pit_loss = base_pit * 0.55;
    elseif strcmp(status_lower, 'sc')
        pit_loss = base_pit * 0.40;
    else
        pit_loss = base_pit;
    end

    % Stay out projection over remaining laps
    stint_laps = (1:rem_laps)';
    old_ages = tyre_age + stint_laps;
    stay_out = base_pace + (wear_rate * old_ages) + (cliff * max(0, old_ages - 10).^1.7);
    total_stay = sum(stay_out);

    % Pit now projection over remaining laps
    pit_proj = base_pace + (wear_rate * stint_laps) + (cliff * max(0, stint_laps - 10).^1.7);
    total_pit = pit_loss + sum(pit_proj);

    % Console output
    fprintf('SC Status: %s | Pit Loss: %.2fs\n', upper(sc_status), pit_loss);
    fprintf('Stay Out: %.2fs | Pit Now: %.2fs\n', total_stay, total_pit);

    if total_pit < total_stay
        fprintf('-> BOX BOX. Delta: %.2fs\n\n', total_stay - total_pit);
    else
        fprintf('-> STAY OUT. Hold track position.\n\n');
    end

    % Plotting
    fig = figure('Position', [100, 100, 700, 400]);
    plot(stint_laps, stay_out, '--r', 'LineWidth', 1.5, 'DisplayName', 'Stay Out (Worn)');
    hold on;
    plot(stint_laps, pit_proj, '-b', 'LineWidth', 1.5, 'DisplayName', 'Pit Now (Fresh)');
    grid on; box on;
    xlabel('Remaining Laps');
    ylabel('Projected Lap Time (s)');
    title(sprintf('F1 Strategy Crossover (%s)', upper(sc_status)));
    legend('Location', 'southeast');

    exportgraphics(fig, 'f1_strategy.png', 'Resolution', 300);
    close(fig);
end
